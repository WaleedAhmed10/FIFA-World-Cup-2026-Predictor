# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local: mongodb://localhost:27017/worldcup2026
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worldcup2026
MONGODB_URI=mongodb://localhost:27017/worldcup2026

# --- JWT secrets ---
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info
